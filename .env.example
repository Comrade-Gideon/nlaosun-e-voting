DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&pgbouncer=true&connection_limit=5&pool_timeout=30"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"
SESSION_SECRET="replace-with-at-least-32-random-characters"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
NEXT_PUBLIC_SITE_URL="https://your-domain.example"


# Cloudflare R2 (S3-compatible). The API token needs Object Read & Write on both
# buckets. The private bucket must have no public access; the public one is
# served from R2_PUBLIC_BASE_URL (an r2.dev subdomain or a custom domain).
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="r2-access-key-id"
R2_SECRET_ACCESS_KEY="r2-secret-access-key"
R2_PRIVATE_BUCKET="nlaosun-private"
R2_PUBLIC_BUCKET="nlaosun-public"
R2_PUBLIC_BASE_URL="https://your-public-bucket-url"

# Gmail API (HTTPS, works on Cloudflare Workers where SMTP does not). In Google
# Cloud Console: enable the Gmail API, create an OAuth client, consent once and
# keep the refresh token. Used for guarantor invitations and admin broadcasts.
GOOGLE_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-oauth-client-secret"
GOOGLE_REFRESH_TOKEN="your-refresh-token"
MAIL_FROM="NLA Osun Election Committee <elections@your-domain.example>"
